# Port to run the Express server on
PORT=5000

# Your Google Gemini API Key. Get one from Google AI Studio.
# Note: You can also override this by entering it directly in the frontend UI.
GEMINI_API_KEY=your_gemini_api_key_here

# The Gemini model version to use for header mapping and batch normalization.
# Allowed options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
